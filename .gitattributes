# Auto-detect text files, normalize line endings to LF in the repository
* text=auto eol=lf

# Explicitly declare text files
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
Dockerfile text eol=lf
Makefile   text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files — no conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.pkl   binary
*.joblib binary
*.pt    binary
*.h5    binary
*.parquet binary
*.csv   binary
